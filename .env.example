# Copy to .env and fill in. Never commit .env.

# CE.SDK license key from https://img.ly/dashboard.
# Without it the editor runs with a watermark.
VITE_CESDK_LICENSE=

# IMG.LY AI Gateway API key (sk_...) from https://img.ly/dashboard.
# Every model call in this demo goes through https://gateway.img.ly with
# this one credential. Leave it empty to run the demo with sample parts
# and no AI generation.
#
# The key is handed to the browser via `{ dangerouslyExposeApiKey }`.
# That is fine on your machine. For a public deployment, mint short-lived
# tokens from a backend instead (see src/app/ai-credentials).
VITE_AI_API_KEY=

# Optional: point at a different gateway. Defaults to https://gateway.img.ly.
# VITE_AI_GATEWAY_URL=
